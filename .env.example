SCRIPTMGR_DATA_DIR=./data
SCRIPTMGR_DB_URL=sqlite:///./data/scriptmgr.db
SCRIPTMGR_HOST=127.0.0.1
SCRIPTMGR_PORT=8765
SCRIPTMGR_LOG_LEVEL=INFO

# Executor mode:
#   inproc  — in-process thread pool (workstation default — no Redis required)
#   celery  — distributed Celery workers (requires Redis broker + worker process)
SCRIPTMGR_EXECUTOR_MODE=inproc

# Celery / Redis (only used when EXECUTOR_MODE=celery)
SCRIPTMGR_BROKER_URL=redis://localhost:6379/0
SCRIPTMGR_RESULT_BACKEND=redis://localhost:6379/1
SCRIPTMGR_WORKER_CONCURRENCY=4

# Notifications
SCRIPTMGR_SMTP_HOST=
SCRIPTMGR_SMTP_PORT=587
SCRIPTMGR_SMTP_USER=
SCRIPTMGR_SMTP_PASSWORD=
SCRIPTMGR_SMTP_FROM=scriptmgr@localhost
SCRIPTMGR_TEAMS_WEBHOOK=
SCRIPTMGR_SLACK_WEBHOOK=

# Log retention (days)
SCRIPTMGR_LOG_RETENTION_DAYS=30
