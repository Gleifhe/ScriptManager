# ---------------------------------------------------------------------------
# PATHS — leave these commented out to use the smart auto-detected defaults.
# config.py walks up from its own location to find pyproject.toml and sets
# data_dir = <repo-root>/data and db_url relative to that, so ScriptManager
# works correctly regardless of the working directory it is invoked from.
#
# Only uncomment and override if you want to store data in a different place:
# SCRIPTMGR_DATA_DIR=C:\ScriptManagerData
# SCRIPTMGR_DB_URL=sqlite:///C:\ScriptManagerData\scriptmgr.db
# ---------------------------------------------------------------------------
SCRIPTMGR_HOST=127.0.0.1
SCRIPTMGR_PORT=8765
SCRIPTMGR_LOG_LEVEL=INFO

# Executor mode:
#   inproc  — in-process thread pool (workstation default — no Redis required)
#   celery  — distributed Celery workers (requires Redis broker + worker process)
SCRIPTMGR_EXECUTOR_MODE=inproc

# Celery / Redis (only used when EXECUTOR_MODE=celery)
SCRIPTMGR_BROKER_URL=redis://localhost:6379/0
SCRIPTMGR_RESULT_BACKEND=redis://localhost:6379/1
SCRIPTMGR_WORKER_CONCURRENCY=4

# Notifications
SCRIPTMGR_SMTP_HOST=
SCRIPTMGR_SMTP_PORT=587
SCRIPTMGR_SMTP_USER=
SCRIPTMGR_SMTP_PASSWORD=
SCRIPTMGR_SMTP_FROM=scriptmgr@localhost
SCRIPTMGR_TEAMS_WEBHOOK=
SCRIPTMGR_SLACK_WEBHOOK=

# Log retention (days)
SCRIPTMGR_LOG_RETENTION_DAYS=30

# API Key (optional) — if set, all /api/* and /ws/* requests must include:
#   Authorization: Bearer <your-key>
# Web UI routes are always accessible. Leave blank to disable auth.
# SCRIPTMGR_API_KEY=
